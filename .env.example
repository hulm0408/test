# ===== Firebase Phone-Registration Pipeline — Environment =====
# ⚠️ YE FILE (.env) KABHI GITHUB PAR MAT DAALNA — key leak = pipeline hijack.
# AIza prefix, 39 chars, ASCII keys ko yahan paste karo (REQUIRED)
FIREBASE_API_KEYS=
# API key validation endpoints (default)
FIREBASE_IDENTITY_URL=https://identitytoolkit.googleapis.com/v1
FIREBASE_PROJECT_URL=https://firebase.googleapis.com/v1

# 💾 Concurrency & Pool
# Worker pool size (100 concurrent registrations)
POOL_SIZE=100
# Max keys per pool rotation (8 per key cap)
KEY_CAP=8
# Health scoring floor/ceiling for exponential backoff
BACKOFF_FLOOR=1000
BACKOFF_CEILING=30000
# Default country code for E.164 normalization
DEFAULT_COUNTRY_CODE=91
# Interval for key rescan (ms)
RESCAN_INTERVAL=60000

# 🛡️ Security & Persistence
# SQLite DB path (persisted so crash resumes exactly where it stopped)
PIPELINE_DB=data/pipeline.db
# Encryption key for secrets (optional)
PIPELINE_ENCRYPTION_KEY=
# Mask secrets in logs (default ON)
MASK_SECRETS=1

# 📊 Dashboard
# Live preview port (default 3000)
DASHBOARD_PORT=3000
# Export CSV path
CSV_EXPORT_PATH=data/exports

# 🔁 Retry Policy
# Max attempts per registration (3)
MAX_ATTEMPTS=3
# Jitter factor (0-1)
BACKOFF_JITTER=0.2
