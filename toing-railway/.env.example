# ============================================================================
# Toing Railway (50 Parallel Slots) — Environment Variables
# ============================================================================

# --- REQUIRED ---
# Naya @BotFather token (workwr live bot wala token mat use karna!)
BOT_TOKEN=
# Comma-separated Telegram User IDs allowed to control this bot
OWNER_IDS=6484999726

# --- RECOMMENDED SECURITY ---
# Strong secret string for AES-256-GCM encrypting TG sessions inside SQLite.
# Agar khali chhodo to /data/.master.key auto-generate ho jata hai, par env me
# set rakhna best practice hai.
VAULT_ENCRYPTION_KEY=

# --- TELEGRAM SPARE ACCOUNTS (DEFAULT API CREDENTIALS) ---
# Ek baar my.telegram.org se API ID + Hash daal do — saare 50 slots isi ko
# reuse kar lenge (per-slot override bhi supported hai).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- TOING PRO WEB API ---
TOING_PRO_BASE_URL=https://storelex.store/toing_web
# Single key ya comma-separated multiple keys (automatic round-robin):
TOING_ACCESS_KEY=TNG-6BMI-SHBL-OOLY
# Max concurrent HTTP requests to storelex.store across all 50 slots
TOING_HTTP_CONCURRENCY=20

# --- OTP BOT & SPEED TUNING (TARGET: 20+ ACCOUNTS / MIN) ---
# Default OTP bot for newly imported slots: hathi | hermes | chauhan
DEFAULT_OTP_BOT=hathi
# Fast-fail OTP wait budget (ms) — 20s drops dead numbers quickly for higher acc/min
OTP_TIMEOUT_MS=20000
# Refresh interval on OTP bot chat (ms) — adaptive backoff kicks in automatically
OTP_REFRESH_MS=1800
# Auto-failover to another OTP bot if current bot fails claims 5x in a row (1=on, 0=off)
AUTO_FAILOVER_BOTS=0
# Skip already-registered numbers immediately BEFORE send_otp (1=on [recommended], 0=off)
SKIP_REGISTERED=1
# Short cooldown (minutes) on a number that timed out waiting for OTP so other slots skip dead SIMs
OTP_TIMEOUT_COOLDOWN_MIN=10
# Max parallel slots active at once (up to 50)
MAX_SLOTS=50

# --- DELIVERY & PERSISTENCE ---
# Railway Volume mount path (1 GB volume mounted at /data)
DATA_DIR=/data
# Optional: send exported .json files to a specific chat/channel instead of owner DM
DELIVERY_CHAT_ID=
# Delay between consecutive .json Telegram document sends (ms) — 1050ms ≈ 55 files/min safely
DELIVERY_GAP_MS=1050
# Used-number cooldown in days (default 30)
USED_COOLDOWN_DAYS=30
# Auto-resume enabled slots after Railway restart/redeploy (1=yes, 0=no)
AUTO_RESUME=1

# --- OPTIONAL BOOTSTRAP SESSIONS ---
# Optional JSON array of sessions to auto-import on first boot:
# TG_SESSIONS_JSON=[{"label":"acc1","otpBot":"hathi","session":"1BVts..."}]
# Or numbered env vars: TELEGRAM_SESSION, TELEGRAM_SESSION_2 ... TELEGRAM_SESSION_50

# Railway injects PORT automatically
PORT=3000
